# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# MongoDB connection string
DB_CONNECT_STRING=your_mongodb_connection_string

# Redis Cloud password (host/port are set in src/config/redis.js)
REDIS_PASS=your_redis_password

# Secret used to sign JWTs (use a long random string)
JWT_KEY=your_jwt_secret

# Judge0 (RapidAPI) key for code execution
JUDGE0_KEY=your_judge0_rapidapi_key

# Google Gemini API key for the AI doubt-solver
GEMINI_KEY=your_gemini_api_key

# Cloudinary credentials for video uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: server port (defaults to 3000)
PORT=3000
